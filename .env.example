# GDG Link Manager Environment Variables

# Supabase Project URL and Anon Key (Available in Supabase Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://zeqkprhqldmawidubcxh.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Supabase Service Role Key (Keep strictly server-side, never expose to client!)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Authorized Admin Emails (Comma-separated list of emails permitted to access /admin)
# e.g., ADMIN_EMAILS=varadaj47@gmail.com,gdgcrce@gmail.com
ADMIN_EMAILS=varadaj47@gmail.com,gdgcrce@gmail.com

# Default redirect URL when unauthenticated users visit root or unauthorized pages
DEFAULT_REDIRECT_URL=https://gdgcrce.com

# Canonical App URL (Used for generating short link QR codes and copy links)
# In production: https://link.gdgcrce.com
# In local development: http://localhost:3000
NEXT_PUBLIC_APP_URL=https://link.gdgcrce.com
